export DOTFILES="$HOME/dotfiles"

if [[ "$OSTYPE" = "darwin"* ]] && (( $(ulimit -Sn) < 65536 )); then
  # Raise the macOS soft file limit when needed.
  ulimit -n 65536
fi

# Set Emacs keybindings before integrations such as fzf add their bindings.
bindkey -e

# Remove duplicate entries from path arrays.
typeset -U path cdpath fpath manpath

# Path
# ------------------------------------------------------------------------------

export CARGO_HOME="$HOME/.cargo"

case "$(uname -m)" in
  arm64)
    [[ -x /opt/homebrew/bin/brew ]] && \
      eval "$(/opt/homebrew/bin/brew shellenv)"
    ;;
  x86_64)
    [[ -x /usr/local/bin/brew ]] && \
      eval "$(/usr/local/bin/brew shellenv)"
    ;;
esac

if [[ -x "/opt/local/bin/port" ]]; then
  path=(
    /opt/local/bin(N-/)
    /opt/local/sbin(N-/)
    $path
  )

  fpath=(/opt/local/share/zsh/site-functions(N-/) $fpath)
elif [[ -n "$HOMEBREW_PREFIX" ]]; then
  path=(
    # Prefer selected Homebrew tools over macOS-provided versions.
    "$HOMEBREW_PREFIX"/lib/ruby/gems/*/bin(N-/)
    "$HOMEBREW_PREFIX"/opt/{ruby,sqlite,llvm,openjdk}/bin(N-/)
    "$HOMEBREW_PREFIX"/opt/make/libexec/gnubin(N-/)
    $path
  )
fi

# Completion paths must be configured before compinit.
fpath=(
  $DOTFILES/config/zsh/plugins/zsh-completions/src(N-/)
  $fpath
)

# Search these parent directories when resolving cd targets.
cdpath=(
  "$HOME"
  "$HOME/work"
  "$HOME/code"
  "$DOTFILES"
)

path=(
  # Local Neovim build.
  "$HOME/neovim/bin"(N-/)

  "$CARGO_HOME/bin"(N-/)

  # Local scripts and uv tool executables.
  "$HOME/.local/bin"(N-/)

  /usr/local/bin(N-/)

  $path
)

# Plugins and shell integrations
# ------------------------------------------------------------------------------

function source_if_exists {
  if [[ -f "$1" ]]; then
    source "$1"
  fi
}

source_if_exists "$DOTFILES"/config/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.plugin.zsh

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#928374'

if (( $+commands[fzf] )); then
  eval "$(fzf --zsh)"
fi

if (( $+commands[starship] )); then
  eval "$(starship init zsh)"
fi

if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi

if (( $+commands[direnv] )); then
  eval "$(direnv hook zsh)"
fi

# Completion
# ------------------------------------------------------------------------------

# Load menu selection before initializing completion.
zmodload zsh/complist

autoload -Uz compinit
compinit

# Bash compatibility is required by the generated dotbot completion.
autoload -Uz bashcompinit
bashcompinit

compdef viw=which
compdef o=open

source_if_exists "$DOTFILES/config/bash/completions/dotbot.bash"

# Completion styles
# ------------------------------------------------------------------------------

ITALIC_ON=$'\e[3m'
ITALIC_OFF=$'\e[23m'

zstyle ':completion:*' menu 'select'

zstyle ':completion:*:messages' format '%F{blue}--- %d ---%f'
zstyle ':completion:*:descriptions' format "%F{yellow}%B${ITALIC_ON}--- %d ---${ITALIC_OFF}%b%f"
zstyle ':completion:*:warnings' format $'%F{red}--- no matches found for ---%f\n%D'

zstyle ':completion:*' group-name ''
zstyle ':completion:*' auto-description 'specify: %d'
zstyle ':completion:*' list-colors ''
zstyle ':completion:*' select-prompt ''
zstyle ':completion:*' list-separator '  #'

# Try exact matches before case-insensitive matches.
zstyle ':completion:*' matcher-list '' 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}'

# Use CDPATH entries only when local directory completion has no matches.
zstyle ':completion:*:*:(cd|pushd):*' tag-order local-directories directory-stack path-directories

zstyle ':completion:*:processes' command 'ps -u $LOGNAME -o pid,user,command -w'
zstyle ':completion:*:processes-names' command 'ps -c -u $LOGNAME -o command | uniq'

zstyle ':completion:*:manuals' separate-sections true
zstyle ':completion:*:manuals.*' insert-sections true

unset ITALIC_ON ITALIC_OFF

# Options
# ------------------------------------------------------------------------------

# Navigation and spelling correction.
setopt AUTO_CD
setopt AUTO_PUSHD
setopt CORRECT
setopt CORRECT_ALL

# History.
setopt EXTENDED_HISTORY
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_VERIFY

# Interactive behavior.
setopt INTERACTIVE_COMMENTS
setopt MAGIC_EQUAL_SUBST
setopt PUSHD_IGNORE_DUPS
setopt SHARE_HISTORY

# Functions, Aliases, Exports
# ------------------------------------------------------------------------------

source "$DOTFILES/config/zsh/lib/functions.zsh"
source "$DOTFILES/config/zsh/lib/aliases.zsh"
source "$DOTFILES/config/zsh/lib/exports.zsh"

# Hooks
# ------------------------------------------------------------------------------

autoload -Uz add-zsh-hook

# Activate or deactivate the nearest Python virtual environment.
# TODO: nested virtual environments
_python_auto_venv() {
  # deactivate may be absent even when VIRTUAL_ENV survived a shell reload.
  if ! typeset -f deactivate &> /dev/null; then
    py-venv-activate
  elif [[ -n "$VIRTUAL_ENV" ]]; then
    # Trailing slashes prevent sibling prefixes from matching the venv root.
    if [[ "$PWD/" != "${VIRTUAL_ENV:h}/"* ]]; then
      deactivate
      py-venv-activate
    fi
  fi
}

add-zsh-hook -Uz precmd _python_auto_venv

# Key Bindings
# ------------------------------------------------------------------------------

# Make Ctrl-W stop at spaces and path separators.
autoload -Uz select-word-style
select-word-style bash

# Shift-Tab cycles backward through completion.
bindkey '\e[Z' reverse-menu-complete

bindkey '\e[3~' delete-char

# Search history using the text before the cursor.
bindkey '\C-p' history-beginning-search-backward
bindkey '\C-n' history-beginning-search-forward

# Preserve the current screen in scrollback before clearing it.
scroll-and-clear-screen() {
  printf '\n%.0s' {1..$LINES}
  zle clear-screen
}
zle -N scroll-and-clear-screen
bindkey '\C-l' scroll-and-clear-screen

# Expand history references when inserting a space.
bindkey ' ' magic-space

# Edit the command line in VISUAL.
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '\C-x\C-e' edit-command-line

bindkey '\C-xh' describe-key-briefly

# Completion menu navigation.
bindkey -M menuselect '\C-j' down-line-or-history
bindkey -M menuselect '\C-k' up-line-or-history
bindkey -M menuselect '\C-h' backward-char
bindkey -M menuselect '\C-l' forward-char

# Menu paging uses key sequences because menuselect cannot run custom widgets.
bindkey -M menuselect '\ej' down-line-or-history
bindkey -M menuselect '\ek' up-line-or-history
bindkey -M menuselect -s '\C-f' '\ej\ej\ej\ej\ej'
bindkey -M menuselect -s '\C-b' '\ek\ek\ek\ek\ek'

# Local
# ------------------------------------------------------------------------------

source_if_exists "$HOME/.zshrc.local"
